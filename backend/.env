SEMAPPS_APP_NAME="PorteJunes"
SEMAPPS_APP_DESCRIPTION="Envoyez et recevez des Ğ1 (monnaie libre) via ActivityPub"
SEMAPPS_APP_LANG="fr"

SEMAPPS_HOME_URL=http://localhost:3011/
SEMAPPS_FRONT_URL=http://localhost:5173/
SEMAPPS_PORT=3011

SEMAPPS_SHAPE_REPOSITORY_URL=https://shapes.activitypods.org/
# Served as static files by the frontend (frontend/public/shapes, frontend/public/shapetrees),
# the same way app.json/access-need-*.json are -- no dedicated backend route needed.
SEMAPPS_PORTEJUNES_SHAPE_REPOSITORY_URL=http://localhost:5173/

# Triple store
SEMAPPS_SPARQL_ENDPOINT=http://localhost:3030/
SEMAPPS_JENA_USER=admin
SEMAPPS_JENA_PASSWORD=admin
SEMAPPS_MAIN_DATASET=portejunes
SEMAPPS_AUTH_ACCOUNTS_DATASET_NAME=settings-portejunes

# Redis (format: redis://localhost:6379/0)
SEMAPPS_REDIS_CACHE_URL=
SEMAPPS_QUEUE_SERVICE_URL=redis://localhost:6379/12

# Duniter / Ğ1
# "g1-test" during development, "g1" only once explicitly ready for real money
SEMAPPS_DUNITER_NETWORK=g1-test
# Comma-separated list, in priority order. Kept here (not fetched from
# git.duniter.org/nodes/networks at runtime) to avoid a hard runtime dependency on that repo;
# re-sync manually against https://git.duniter.org/nodes/networks/-/raw/master/gtest.json (or
# g1.json for mainnet) periodically.
SEMAPPS_DUNITER_RPC_ENDPOINTS=wss://gtest.1000i100.fr,wss://gtest.asycn.io/ws/,wss://gtest.cgeek.fr,wss://gt.p2p.legal/ws
SEMAPPS_DUNITER_INDEXER_URL=https://squid.gtest.coinduf.eu/v1/graphql
SEMAPPS_DUNITER_SS58_FORMAT=4450
