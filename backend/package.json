{
  "name": "portejunes-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx node_modules/moleculer/bin/moleculer-runner.js --hot --repl services/*.service.js services/**/*.service.js",
    "start": "tsx node_modules/moleculer/bin/moleculer-runner.js services/*.service.js services/**/*.service.js",
    "link-packages": "yarn link @activitypods/app",
    "unlink-packages": "yarn unlink @activitypods/app && yarn install --force"
  },
  "dependencies": {
    "@activitypods/app": "2.3.2",
    "@semapps/auth": "1.2.4",
    "@semapps/core": "1.2.4",
    "@semapps/crypto": "1.2.4",
    "@semapps/nodeinfo": "1.2.4",
    "@semapps/notifications": "1.2.4",
    "@semapps/ontologies": "1.2.4",
    "@semapps/solid": "1.2.4",
    "@semapps/triplestore": "1.2.4",
    "dotenv-flow": "^3.2.0",
    "ioredis": "^4.17.3",
    "moleculer": "^0.14.35",
    "moleculer-repl": "^0.6.6",
    "url-join": "^4.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "devDependencies": {
    "tsx": "^4.20.3"
  }
}
