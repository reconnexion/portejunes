VITE_APP_NAME="PorteJunes"
VITE_APP_LANG="fr"

# PorteJunes has its own app backend (unlike @activitypods/refine-providers' no-backend example)
# so the app's Solid-OIDC client_id is the app actor the backend's AppService creates/hosts
# dynamically at startup (see app.service.js), not a static frontend file. Verified against a
# running backend: ControlledContainerMixin's `path: '/as/actor'` setting does NOT become part
# of the actor's own URL (that's just the internal container registration path) -- the actor
# itself is created directly at `${HOME_URL}app` (slug 'app'), confirmed via
# `curl http://localhost:3004/app` returning the actor document.
VITE_BACKEND_URL=http://localhost:3004/
VITE_CLIENT_ID=http://localhost:3004/app

VITE_SHAPE_REPOSITORY_URL=https://shapes.activitypods.org/
# This app's own shapetree (g1:WalletSecret) -- served by docker-compose-shapes.yml (`make
# shapes`), not by this frontend or the backend. See backend/.env for why it needs its own origin.
VITE_PORTEJUNES_SHAPE_REPOSITORY_URL=http://localhost:3005/

VITE_POD_PROVIDER_URL=http://localhost:3000

# Duniter / Ğ1 -- "g1-test" during development, "g1" only once explicitly ready for real money
VITE_DUNITER_NETWORK=g1-test
VITE_DUNITER_RPC_ENDPOINTS=wss://gtest.1000i100.fr,wss://gtest.asycn.io/ws/,wss://gtest.cgeek.fr,wss://gt.p2p.legal/ws
VITE_DUNITER_INDEXER_URL=https://squid.gtest.coinduf.eu/v1/graphql
VITE_DUNITER_SS58_FORMAT=4450
